<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
<xs:element name="usuarios">
    <xs:complexType>
        <xs:sequence>
            <xs:element name="usuario">
                <xs:complexType>
                    <xs:sequence>
                        <xs:element name="email">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="^[a-zA-Z0-9._]{1,64}@[a-zA-Z0-9._]{1,255}\.[a-z]{2,4}$"/>
                                </xs:restriction>        
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="telefono">
                            <xs:simpleType>
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="^\+34[0-9]{9}$"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="codigoPostal">
                            <xs:simpleType>
                                <xs:restriction base="xs:string"> 
                                    <xs:pattern value="^(0[1-9]|[1-4][0-9]|5[0-2])[0-9]{3}$"/>
                                </xs:restriction>
                            </xs:simpleType>    
                        </xs:element>
                        <xs:element name="nombreUsuario">
                            <xs:simpleType>    
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="^[a-z0-9]{1}[a-z0-9._]{5,29}$"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                        <xs:element name="contraseña">
                            <xs:simpleType>    
                                <xs:restriction base="xs:string">
                                    <xs:pattern value="^[a-zA-Z0-9]{1}[a-zA-Z0-9._*+=]{5,29}$"/>
                                </xs:restriction>
                            </xs:simpleType>
                        </xs:element>
                    </xs:sequence>
                </xs:complexType>
            </xs:element>
        </xs:sequence>
    </xs:complexType>
</xs:element>
</xs:schema>